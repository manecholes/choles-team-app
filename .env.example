# ============================================
# CHOLES TEAM APP - Variables de entorno (ejemplo)
# Copiar este archivo a ".env" y ajustar los valores.
# NUNCA subir el archivo ".env" real a un repositorio.
# ============================================

# --- Base de datos MySQL (XAMPP) ---
# XAMPP normalmente usa 127.0.0.1:3306. Si tienes otro servicio usando
# el puerto 3306 (otro MySQL, WAMP, etc.) cambia DB_PORT a 3307 y
# ajusta el puerto de MySQL en el panel de XAMPP (my.ini -> port).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=choles_team_2026
DB_USER=root
DB_PASSWORD=

# Prisma arma la URL de conexion a partir de las variables de arriba.
# No es necesario editar esta linea manualmente.
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# --- Autenticacion ---
# Generar valores propios y unicos en produccion, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-este-valor-por-uno-propio-y-largo
JWT_REFRESH_SECRET=cambia-este-otro-valor-tambien-largo-y-distinto
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Aplicacion ---
NEXT_PUBLIC_APP_NAME="Choles Team App"
NEXT_PUBLIC_APP_SLOGAN="Juntos, somos Choles Team."
APP_URL=http://localhost:3000
PORT=3000

# --- Almacenamiento de archivos ---
# "local" guarda en la carpeta /storage del proyecto.
# Dejar preparado para cambiar a "s3" en el futuro sin tocar el codigo de negocio.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# --- Semilla / entorno ---
NODE_ENV=development

# --- Credenciales demo (SOLO DESARROLLO) ---
# Este usuario se crea con el seed (npm run db:seed) y queda marcado
# con mustChangePassword=true para forzar el cambio de clave en el primer login.
DEMO_ADMIN_EMAIL=admin@cholesteam.com
DEMO_ADMIN_PASSWORD=Admin123!

# --- Bot de WhatsApp (punto 30 del maestro) ---
# Todos estos valores salen del panel de Meta for Developers, en la app de
# WhatsApp del club (Configuracion de la API / Paso 2: Configuracion de
# produccion). No compartir estos valores fuera del equipo del club.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token inventado por ti (cualquier texto largo), se escribe tambien en Meta
# al configurar la URL del webhook -- debe ser IDENTICO en los dos lados.
WHATSAPP_VERIFY_TOKEN=
# Numero de WhatsApp (con indicativo de pais, solo numeros, ej. 573001234567)
# del administrador del club que va a confirmar los comprobantes de pago.
WHATSAPP_ADMIN_PHONE=
# Opcional: correo del usuario ADMIN de la plataforma, para que los pagos
# registrados por el bot queden atribuidos a ese usuario. Si se deja vacio,
# el pago igual se registra, solo sin "registrado por".
WHATSAPP_ADMIN_EMAIL=
# Slug del club que atiende este numero de WhatsApp (ver prisma/seed.ts).
# Deja "choles-team" mientras solo exista un club en esta instalacion.
WHATSAPP_CLUB_SLUG=choles-team

# --- IA del bot de WhatsApp (cuenta aparte en console.anthropic.com) ---
# Esta es una cuenta y facturacion DISTINTA a una suscripcion normal de
# Claude.ai -- se crea en https://console.anthropic.com, genera su propia
# llave (API key) y tiene su propio costo segun el uso del bot.
ANTHROPIC_API_KEY=
# Copia el nombre EXACTO del modelo desde console.anthropic.com > Docs >
# Models (los nombres de modelo cambian con el tiempo, por eso no traemos
# aqui un valor por defecto). Ejemplo de formato: claude-sonnet-4-5-20250929
ANTHROPIC_MODEL=
